{
  "rootDir": "..",
  "moduleFileExtensions": ["js", "json", "ts"],
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/test/tsconfig.json" }]
  },
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "testTimeout": 60000,
  "maxWorkers": 1,
  "forceExit": true,
  "transformIgnorePatterns": []
}
