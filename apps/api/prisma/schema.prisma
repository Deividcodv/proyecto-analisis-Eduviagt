// SIGEB - Sistema Integral de Gestión de Becas
// Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UsuarioEstado {
  ACTIVO
  INACTIVO
}

enum SolicitudEstado {
  BORRADOR
  ENVIADA
  EN_REVISION
  CORRECCION
  EVALUADA
  PENDIENTE_SEGUNDA_APROBACION
  APROBADA
  RECHAZADA
}

enum ConvocatoriaEstado {
  BORRADOR
  ABIERTA
  CERRADA
  EN_EVALUACION
  RESUELTA
  ARCHIVADA
}

enum PermisoEfecto {
  PERMITIR
  DENEGAR
}

enum SolicitudDocumentoEstado {
  PENDIENTE
  CARGADO
  RECHAZADO
}

enum BecaCobertura {
  PARCIAL
  COMPLETA
}

// ==========================================
// SEGURIDAD Y USUARIOS
// ==========================================

model Usuario {
  id              String        @id @default(uuid())
  cui             String        @unique
  nombres         String
  email           String        @unique
  passwordHash    String
  telefono        String?
  fechaNacimiento DateTime?
  direccion       String?
  generoId        String?
  departamentoId  String?
  municipioId     String?
  rolId           String
  estado          UsuarioEstado @default(ACTIVO)
  /// Marca la cuenta como eliminada: los datos personales se anonimizan, pero
  /// la fila se conserva para no romper la trazabilidad de las decisiones.
  eliminadoAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  rol                Rol                   @relation(fields: [rolId], references: [id])
  genero             Genero?               @relation(fields: [generoId], references: [id])
  departamento       Departamento?         @relation(fields: [departamentoId], references: [id])
  municipio          Municipio?            @relation(fields: [municipioId], references: [id])
  solicitudes        Solicitud[]
  usuarioPermisos    UsuarioPermiso[]
  comiteMiembros     ComiteMiembro[]
  evaluaciones       Evaluacion[]
  votos              Voto[]
  auditLogs          AuditLog[]
  notificaciones     Notificacion[]
  aprobacionesHechas            SolicitudAprobacion[]
  configuracion                ConfiguracionUsuario?
  convocatoriasEvaluadorDefault Convocatoria[] @relation("ConvocatoriaEvaluadorPorDefecto")

  @@index([eliminadoAt])
  @@map("usuario")
}

model Rol {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usuarios    Usuario[]
  rolPermisos RolPermiso[]

  @@map("rol")
}

model Permiso {
  id        String   @id @default(uuid())
  modulo    String
  accion    String
  createdAt DateTime @default(now())

  rolPermisos     RolPermiso[]
  usuarioPermisos UsuarioPermiso[]

  @@unique([modulo, accion])
  @@map("permiso")
}

model RolPermiso {
  id        String   @id @default(uuid())
  rolId     String
  permisoId String
  createdAt DateTime @default(now())

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@unique([rolId, permisoId])
  @@map("rol_permiso")
}

model UsuarioPermiso {
  id        String        @id @default(uuid())
  usuarioId String
  permisoId String
  efecto    PermisoEfecto
  createdAt DateTime      @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, permisoId])
  @@map("usuario_permiso")
}

// ==========================================
// CATÁLOGOS
// ==========================================

model Genero {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(true)

  perfiles SolicitudPerfilAcademico[]
  usuarios Usuario[]

  @@map("genero")
}

model NivelAcademico {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(true)

  perfiles      SolicitudPerfilAcademico[]
  convocatorias Convocatoria[]

  @@map("nivel_academico")
}

model Departamento {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(true)

  municipios Municipio[]
  perfiles   SolicitudPerfilAcademico[]
  usuarios   Usuario[]

  @@map("departamento")
}

model Municipio {
  id             String  @id @default(uuid())
  nombre         String
  departamentoId String
  activo         Boolean @default(true)

  departamento Departamento               @relation(fields: [departamentoId], references: [id])
  perfiles     SolicitudPerfilAcademico[]
  usuarios     Usuario[]

  @@unique([nombre, departamentoId])
  @@map("municipio")
}

model InstitucionEducativa {
  id           String   @id @default(uuid())
  nombre       String
  nivel        String
  sector       String?
  departamento String?
  municipio    String?
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([nivel])
  @@index([nombre])
  @@map("institucion_educativa")
}

// ==========================================
// BECAS
// ==========================================

model Beca {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  activa      Boolean  @default(true)
  // Monto de referencia (informativo). El monto que se otorga lo define la
  // Convocatoria (montoBase + reglasMonto), porque depende del ciclo.
  montoBase   Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  convocatorias       Convocatoria[]
  criteriosEvaluacion CriterioEvaluacion[]

  @@map("beca")
}

model CriterioEvaluacion {
  id     String  @id @default(uuid())
  becaId String
  nombre String
  peso   Float
  activo Boolean @default(true)

  beca         Beca         @relation(fields: [becaId], references: [id])
  evaluaciones Evaluacion[]

  @@map("criterio_evaluacion")
}

// ==========================================
// CONVOCATORIAS
// ==========================================

model Convocatoria {
  id                 String             @id @default(uuid())
  nombre             String
  descripcion        String?
  becaId             String
  nivelAcademicoId   String?
  cobertura          BecaCobertura?
  formulario         Json?
  estado             ConvocatoriaEstado @default(BORRADOR)
  fechaApertura      DateTime?
  fechaCierre        DateTime?
  evaluadoresMinimos Int                @default(2)
  maxCorrecciones    Int                @default(3)
  // Montos (Sprint 8): monto base de la beca y reglas por tramo de ingreso.
  moneda             String             @default("GTQ")
  montoBase          Decimal?           @db.Decimal(12, 2)
  permiteParcial     Boolean            @default(true)
  usarReglasMonto    Boolean            @default(false)
  // Sprint 9: evaluador por defecto sugerido al asignar evaluadores a las
  // postulaciones de esta convocatoria. Siempre editable y quitable.
  evaluadorPorDefectoId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  beca                 Beca                       @relation(fields: [becaId], references: [id])
  nivelAcademico       NivelAcademico?            @relation(fields: [nivelAcademicoId], references: [id])
  evaluadorPorDefecto  Usuario?                   @relation("ConvocatoriaEvaluadorPorDefecto", fields: [evaluadorPorDefectoId], references: [id], onDelete: SetNull)
  documentosRequeridos ConvocatoriaDocRequerido[]
  solicitudes          Solicitud[]
  reglasMonto          ConvocatoriaReglaMonto[]

  @@map("convocatoria")
}

/// Regla de cálculo del monto otorgable según el ingreso familiar del
/// postulante (Sprint 8 - US-801).
model ConvocatoriaReglaMonto {
  id             String   @id @default(uuid())
  convocatoriaId String
  nombre         String
  ingresoMin     Decimal? @db.Decimal(12, 2)
  ingresoMax     Decimal? @db.Decimal(12, 2)
  /// FIJO | PORCENTAJE | COMPLETO
  tipo           String
  montoFijo      Decimal? @db.Decimal(12, 2)
  porcentaje     Float?
  prioridad      Int      @default(0)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())

  convocatoria Convocatoria @relation(fields: [convocatoriaId], references: [id], onDelete: Cascade)

  @@index([convocatoriaId])
  @@map("convocatoria_regla_monto")
}

model ConvocatoriaDocRequerido {
  id              String  @id @default(uuid())
  convocatoriaId  String
  documentoTipoId String
  obligatorio     Boolean @default(true)

  convocatoria  Convocatoria  @relation(fields: [convocatoriaId], references: [id], onDelete: Cascade)
  documentoTipo DocumentoTipo @relation(fields: [documentoTipoId], references: [id])

  @@unique([convocatoriaId, documentoTipoId])
  @@map("convocatoria_doc_requerido")
}

// ==========================================
// SOLICITUDES
// ==========================================

model Solicitud {
  id                 String          @id @default(uuid())
  convocatoriaId     String
  usuarioId          String
  estado             SolicitudEstado @default(BORRADOR)
  correccionesCount  Int             @default(0)
  respuestas         Json?
  formularioSnapshot Json?
  // Montos (Sprint 8 - US-801/802): monto que se otorgará, monto ya
  // aprobado y trazabilidad del cálculo.
  montoOtorgable     Decimal?        @db.Decimal(12, 2)
  montoAprobado      Decimal?        @db.Decimal(12, 2)
  montoOrigenCalculo String? // REGLA | MONTO_BASE | OVERRIDE
  montoCalculadoAt   DateTime?
  montoCalculadoPor  String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  convocatoria     Convocatoria               @relation(fields: [convocatoriaId], references: [id])
  usuario          Usuario                    @relation(fields: [usuarioId], references: [id])
  perfilAcademico  SolicitudPerfilAcademico?
  perfilFinanciero SolicitudPerfilFinanciero?
  documentos       SolicitudDocumento[]
  historial        HistorialEstado[]
  evaluaciones     Evaluacion[]
  votos            Voto[]
  decision         Decision?
  sesionesAgenda   SesionAgenda[]
  aprobaciones     SolicitudAprobacion[]

  @@map("solicitud")
}

/// Aprobación de una solicitud (Sprint 8 - US-802/803). Registra cada
/// instancia de aprobación: nivel 1 (primera) y nivel 2 (segunda).
model SolicitudAprobacion {
  id          String   @id @default(uuid())
  solicitudId String
  usuarioId   String
  rolNombre   String
  /// 1 = primera instancia, 2 = segunda instancia
  nivel       Int
  /// aprobar | rechazar | aprobar_segunda | devolver_a_revision
  accion      String
  /// APROBADA | RECHAZADA | DEVUELTA_A_REVISION | PENDIENTE_SEGUNDA_APROBACION
  resultado   String
  comentario  String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  solicitud Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([solicitudId])
  @@index([usuarioId])
  @@index([createdAt])
  @@map("solicitud_aprobacion")
}

model SolicitudPerfilAcademico {
  id                 String  @id @default(uuid())
  solicitudId        String  @unique
  generoId           String?
  generoOtro         String?
  nivelAcademicoId   String?
  nivelAcademicoOtro String?
  institucion        String?
  carrera            String?
  promedio           Float?
  departamentoId     String?
  departamentoOtro   String?
  municipioId        String?
  municipioOtro      String?

  solicitud      Solicitud       @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  genero         Genero?         @relation(fields: [generoId], references: [id])
  nivelAcademico NivelAcademico? @relation(fields: [nivelAcademicoId], references: [id])
  departamento   Departamento?   @relation(fields: [departamentoId], references: [id])
  municipio      Municipio?      @relation(fields: [municipioId], references: [id])

  @@map("solicitud_perfil_academico")
}

model SolicitudPerfilFinanciero {
  id                   String  @id @default(uuid())
  solicitudId          String  @unique
  ingresoFamiliar      Float?
  numeroDependientes   Int?
  becasAnteriores      Boolean @default(false)
  descripcionSituacion String?

  solicitud Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@map("solicitud_perfil_financiero")
}

model SolicitudDocumento {
  id                String                   @id @default(uuid())
  solicitudId       String
  documentoTipoId   String
  archivoUrl        String
  estado            SolicitudDocumentoEstado @default(PENDIENTE)
  version           Int                      @default(1)
  comentarioRechazo String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  solicitud     Solicitud     @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  documentoTipo DocumentoTipo @relation(fields: [documentoTipoId], references: [id])

  @@map("solicitud_documento")
}

model HistorialEstado {
  id          String   @id @default(uuid())
  solicitudId String
  estado      String
  comentario  String?
  usuarioId   String
  /// Acción realizada (Sprint 8 - US-805): enviar, aprobar, devolver_a_revision...
  accion      String?
  /// Resultado de la acción: EXITOSO | RECHAZADO | ERROR
  resultado   String?
  ip          String?
  createdAt   DateTime @default(now())

  solicitud Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@map("historial_estado")
}

// ==========================================
// DOCUMENTOS TIPO
// ==========================================

model DocumentoTipo {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(true)

  convocatoriaDocRequeridos ConvocatoriaDocRequerido[]
  solicitudDocumentos       SolicitudDocumento[]

  @@map("documento_tipo")
}

// ==========================================
// EVALUACIONES
// ==========================================

model Evaluacion {
  id                   String   @id @default(uuid())
  solicitudId          String
  criterioEvaluacionId String
  evaluadorId          String
  puntaje              Float?
  observaciones        String?
  completada           Boolean  @default(false)
  confirmImparcialidad Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  solicitud          Solicitud          @relation(fields: [solicitudId], references: [id])
  criterioEvaluacion CriterioEvaluacion @relation(fields: [criterioEvaluacionId], references: [id])
  evaluador          Usuario            @relation(fields: [evaluadorId], references: [id])

  @@map("evaluacion")
}

// ==========================================
// COMITÉS
// ==========================================

model Comite {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  miembros ComiteMiembro[]
  sesiones Sesion[]

  @@map("comite")
}

model ComiteMiembro {
  id        String   @id @default(uuid())
  comiteId  String
  usuarioId String
  rol       String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  comite  Comite  @relation(fields: [comiteId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([comiteId, usuarioId])
  @@map("comite_miembro")
}

model Sesion {
  id           String   @id @default(uuid())
  comiteId     String
  fecha        DateTime
  lugar        String?
  estado       String   @default("PROGRAMADA")
  quorumMinimo Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  comite     Comite         @relation(fields: [comiteId], references: [id])
  votos      Voto[]
  decisiones Decision[]
  agenda     SesionAgenda[]

  @@map("sesion")
}

model SesionAgenda {
  id          String   @id @default(uuid())
  sesionId    String
  solicitudId String
  createdAt   DateTime @default(now())

  sesion    Sesion    @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  solicitud Solicitud @relation(fields: [solicitudId], references: [id])

  @@unique([sesionId, solicitudId])
  @@map("sesion_agenda")
}

model Voto {
  id            String   @id @default(uuid())
  sesionId      String
  solicitudId   String
  usuarioId     String
  voto          String
  observaciones String?
  createdAt     DateTime @default(now())

  sesion    Sesion    @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  solicitud Solicitud @relation(fields: [solicitudId], references: [id])
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  @@unique([sesionId, solicitudId, usuarioId])
  @@map("voto")
}

// ==========================================
// DECISIONES
// ==========================================

model Decision {
  id            String   @id @default(uuid())
  solicitudId   String   @unique
  sesionId      String
  resultado     String
  observaciones String?
  fecha         DateTime @default(now())

  solicitud Solicitud @relation(fields: [solicitudId], references: [id])
  sesion    Sesion    @relation(fields: [sesionId], references: [id])

  @@map("decision")
}

// ==========================================
// AUDITORÍA
// ==========================================

model AuditLog {
  id        String   @id @default(uuid())
  usuarioId String
  accion    String
  entidad   String
  entidadId String?
  detalle   Json?
  ip        String?
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("audit_log")
}

// ==========================================
// NOTIFICACIONES
// ==========================================

model Notificacion {
  id        String    @id @default(uuid())
  usuarioId String
  tipo      String
  titulo    String
  cuerpo    String?
  leidaAt   DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("notificacion")
}

// ==========================================
// BITÁCORA DEL SISTEMA (Sprint 8 - US-805)
// ==========================================

/// Bitácora inmutable y de solo consulta: registra quién, cuándo, qué y con
/// qué resultado se realizó cada acción relevante del sistema.
model BitacoraSistema {
  id                String   @id @default(uuid())
  fechaHora         DateTime @default(now())
  actorId           String?
  actorNombre       String?
  actorRol          String?
  actorCorreo       String?
  modulo            String
  entidad           String
  entidadId         String?
  /// Clave técnica de la acción (p. ej. "solicitud.aprobar").
  accionClave       String
  /// La misma acción, en lenguaje comprensible ("Aprobó la solicitud").
  accionHumana      String
  descripcionHumana String
  camposClave       Json?
  datosRelevantes   Json?
  /// EXITOSO | RECHAZADO | ERROR
  resultado         String
  motivo            String?
  ip                String?
  userAgent         String?
  /// WEB | API
  origen            String   @default("API")
  correlacionId     String?
  sessionId         String?

  @@index([fechaHora])
  @@index([actorId])
  @@index([entidad, entidadId])
  @@index([accionClave])
  @@index([modulo])
  @@map("bitacora_sistema")
}

/// Preferencias de notificaciones y sonido del usuario (Sprint 8 - US-804).
model ConfiguracionUsuario {
  id                    String   @id @default(uuid())
  usuarioId             String   @unique
  notificacionesActivas Boolean  @default(true)
  sonidoNotificaciones  Boolean  @default(true)
  volumenSonido         Int      @default(40)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("configuracion_usuario")
}

// ==========================================
// ASISTENTE IA
// ==========================================

model AsistenteBaseConocimiento {
  id        String   @id @default(uuid())
  titulo    String
  contenido String
  tags      String[]
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
  @@map("asistente_base_conocimiento")
}

model AsistenteConversacion {
  id        String   @id @default(uuid())
  usuarioId String?
  sesionId  String?
  createdAt DateTime @default(now())

  mensajes AsistenteMensaje[]

  @@map("asistente_conversacion")
}

model AsistenteMensaje {
  id             String   @id @default(uuid())
  conversacionId String
  rol            String
  contenido      String
  contexto       Json?
  createdAt      DateTime @default(now())

  conversacion AsistenteConversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@map("asistente_mensaje")
}
