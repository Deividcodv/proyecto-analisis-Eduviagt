# Copiar a .env y ajustar por entorno (desarrollo usa docker-compose.yml).

# --- Base de datos ---
DATABASE_URL=postgresql://sigeb:sigeb123@localhost:5432/sigeb
POSTGRES_DB=sigeb
POSTGRES_USER=sigeb
DB_PASSWORD=sigeb123
POSTGRES_PORT=5432

# --- Seguridad (secrets reales en staging/producción) ---
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo
JWT_REFRESH_EXPIRATION=7d

# --- API ---
PORT=3000
CORS_ORIGIN=http://localhost:3001
STORAGE_PATH=./storage

# --- Asistente IA (opcional; sin AI_API_KEY usa la base de conocimiento) ---
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# --- PDF (US-F7): ruta de Chromium del sistema (opcional) ---
CHROME_EXECUTABLE_PATH=

# --- Despliegue (docker-compose.prod.yml) ---
API_PORT=3000
WEB_PORT=3001